{
  "name": "saas-batch-bot",
  "version": "1.0.0",
  "private": true,
  "description": "CSV-driven Playwright bot for multi-account SaaS task select → publish",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "run": "tsx src/index.ts",
    "schemes": "tsx src/index.ts --list-schemes",
    "dry-run": "tsx src/index.ts --dry-run",
    "failed": "tsx src/index.ts --only-failed",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "playwright": "^1.54.2"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
