{
  "baseUrl": "https://your-saas.example.com",
  "loginPath": "/login",
  "tasksPath": "/tasks",
  "headless": false,
  "concurrency": 1,
  "slowMoMs": 80,
  "navigationTimeoutMs": 45000,
  "actionTimeoutMs": 20000,
  "delayBetweenAccountsMs": {
    "min": 3000,
    "max": 10000
  },
  "delayBetweenActionsMs": {
    "min": 400,
    "max": 1200
  },
  "maxTasksPerAccount": 5,
  "reuseStorageState": true,
  "selectors": {
    "usernameInput": "input[name='username'], input[type='email'], #username",
    "passwordInput": "input[name='password'], input[type='password'], #password",
    "loginButton": "button[type='submit'], button:has-text('登录'), button:has-text('Login')",
    "taskCheckbox": "[data-testid='task-checkbox'], input[type='checkbox'][name='task'], .task-item input[type='checkbox']",
    "taskRow": "[data-testid='task-row'], .task-item, tr.task-row",
    "nextButton": "button:has-text('下一步'), button:has-text('Next')",
    "publishButton": "button:has-text('发布'), button:has-text('Publish')",
    "successToast": ".toast-success, [data-testid='publish-success'], text=发布成功"
  },
  "paths": {
    "accountsCsv": "data/accounts.csv",
    "authDir": "auth",
    "outputDir": "output"
  }
}
