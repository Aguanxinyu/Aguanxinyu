.todo-page {
  padding-bottom: 380rpx;
}

.masthead {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 12rpx 4rpx 4rpx;
}

.masthead-copy {
  flex: 1;
  min-width: 0;
}

.day-line {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 22rpx;
}

.day-title {
  font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.day-count {
  color: var(--ink-soft);
  font-size: 24rpx;
}

.add-button {
  width: 88rpx;
  height: 88rpx;
  margin: 8rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 8rpx;
  background: var(--ink);
  color: #f8f4eb;
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.add-button::after,
.quick-button::after,
.rail-toggle::after,
.month-nav::after,
.today-jump::after {
  border: 0;
}

.offline-tip {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 8rpx;
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 24rpx;
}

.task-list {
  margin-top: 28rpx;
  border-top: 1rpx solid var(--line);
}

.task-row {
  display: flex;
  min-height: 118rpx;
  align-items: center;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid var(--line);
}

.task-toggle {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
}

.task-row--pressed {
  background: rgba(16, 36, 58, 0.04);
}

.check {
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid rgba(16, 36, 58, 0.22);
  border-radius: 50%;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 42rpx;
  text-align: center;
}

.task-row--done .check {
  border-color: var(--accent);
  background: var(--accent);
}

.task-content {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.task-title {
  display: block;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-row--done .task-title {
  color: var(--ink-soft);
  text-decoration: line-through;
}

.task-meta {
  display: flex;
  gap: 14rpx;
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
}

.priority {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 700;
}

.priority--HIGH {
  background: var(--high-soft);
  color: var(--high);
}

.priority--MEDIUM {
  background: var(--mid-soft);
  color: var(--mid);
}

.priority--LOW {
  background: var(--low-soft);
  color: var(--low);
}

.task-more {
  width: 72rpx;
  height: 72rpx;
  margin: 0 0 0 8rpx;
  padding: 0;
  border: 0;
  border-radius: 8rpx;
  background: transparent;
  color: var(--ink-soft);
  font-size: 34rpx;
  line-height: 66rpx;
}

.task-more::after {
  border: 0;
}

.load-more {
  padding: 24rpx 0 12rpx;
  color: rgba(16, 36, 58, 0.45);
  font-size: 22rpx;
  text-align: center;
}

.dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom) + 110rpx);
  background:
    linear-gradient(180deg, rgba(243, 239, 230, 0) 0%, rgba(243, 239, 230, 0.92) 28%, #ebe4d6 100%);
}

.quick-create {
  display: flex;
  align-items: center;
  padding: 12rpx 12rpx 12rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: rgba(255, 253, 248, 0.96);
}

.quick-create input {
  flex: 1;
  height: 68rpx;
  font-size: 28rpx;
}

.quick-button {
  width: 116rpx;
  height: 68rpx;
  margin: 0 0 0 12rpx;
  padding: 0;
  border: 0;
  border-radius: 8rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 68rpx;
}

.calendar-rail {
  margin-top: 14rpx;
  padding: 18rpx 18rpx 16rpx;
  border: 1rpx solid rgba(16, 36, 58, 0.1);
  border-radius: 8rpx;
  background: rgba(255, 253, 248, 0.98);
  box-shadow: 0 -8rpx 28rpx rgba(16, 36, 58, 0.06);
}

.rail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.rail-title {
  color: var(--ink);
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 28rpx;
  font-weight: 700;
}

.rail-toggle {
  margin: 0;
  padding: 0 16rpx;
  height: 52rpx;
  border: 0;
  border-radius: 8rpx;
  background: var(--paper-deep);
  color: var(--ink-soft);
  font-size: 22rpx;
  line-height: 52rpx;
}

.week-strip {
  display: flex;
  width: 100%;
  white-space: nowrap;
}

.week-day {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 96rpx;
  margin-right: 10rpx;
  border-radius: 8rpx;
  background: transparent;
  color: var(--ink-soft);
}

.week-day--today {
  box-shadow: inset 0 0 0 2rpx rgba(15, 118, 110, 0.35);
}

.week-day--active {
  background: var(--ink);
  color: #f7f2e8;
  box-shadow: none;
}

.week-weekday {
  font-size: 20rpx;
}

.week-number {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.calendar-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(16, 36, 58, 0.42);
}

.calendar-sheet {
  width: 100%;
  padding: 18rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 18rpx 18rpx 0 0;
  background: #fffdf8;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: rgba(16, 36, 58, 0.16);
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.sheet-title {
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 32rpx;
  font-weight: 700;
}

.month-nav {
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 8rpx;
  background: var(--paper-deep);
  color: var(--ink);
  font-size: 34rpx;
  line-height: 64rpx;
}

.weekday-row,
.month-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.weekday-row {
  margin-bottom: 8rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
  text-align: center;
}

.month-day {
  height: 72rpx;
  border-radius: 8rpx;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
}

.month-day--muted {
  color: rgba(16, 36, 58, 0.28);
}

.month-day--today {
  box-shadow: inset 0 0 0 2rpx rgba(15, 118, 110, 0.4);
}

.month-day--active {
  background: var(--accent);
  color: #ffffff;
  box-shadow: none;
}

.today-jump {
  width: 100%;
  margin-top: 22rpx;
  height: 72rpx;
  line-height: 72rpx;
}
