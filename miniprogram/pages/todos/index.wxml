<view class="page todo-page">
  <view class="hero">
    <view>
      <text class="page-title">今日待办</text>
      <view class="page-subtitle">{{dateLabel}}</view>
    </view>
    <button class="add-button" bindtap="onOpenEditor" aria-label="创建详细待办">＋</button>
  </view>

  <view
    class="offline-tip"
    hidden="{{pendingCount === 0}}"
    aria-live="polite"
    aria-atomic="true"
  >
    {{pendingCount}} 项操作将在恢复网络后同步
  </view>

  <view class="section-title">全部事项 · {{tasks.length}}</view>
  <view class="card task-card">
    <view
      wx:for="{{tasks}}"
      wx:key="id"
      wx:for-item="task"
      class="task-row {{task.done ? 'task-row--done' : ''}}"
      data-id="{{task.id}}"
      bindlongpress="onTaskMenu"
      hover-class="task-row--pressed"
    >
      <view
        class="task-toggle"
        data-id="{{task.id}}"
        bindtap="onToggle"
        role="checkbox"
        aria-checked="{{task.done}}"
        aria-label="{{task.title}}，优先级：{{task.priorityLabel}}，截止：{{task.dueLabel}}，{{task.done ? '已完成' : '未完成'}}"
      >
        <view class="check" aria-hidden="true">{{task.done ? '✓' : ''}}</view>
        <view class="task-content">
          <text class="task-title">{{task.title}}</text>
          <view class="task-meta">
            <text class="priority priority--{{task.priority}}">{{task.priorityLabel}}</text>
            <text>{{task.dueLabel}}</text>
          </view>
        </view>
      </view>
      <button
        class="task-more"
        data-id="{{task.id}}"
        catchtap="onTaskMenu"
        aria-label="{{task.title}} 的更多操作"
      >
        ⋯
      </button>
    </view>

    <view wx:if="{{tasks.length === 0}}" class="empty">
      今天还没有待办，先写下第一件事
    </view>
  </view>

  <view class="quick-create card">
    <input
      value="{{quickTitle}}"
      placeholder="快速记下一件事…"
      maxlength="100"
      confirm-type="done"
      bindinput="onQuickInput"
      bindconfirm="onQuickAdd"
      aria-label="待办标题"
    />
    <button
      class="quick-button"
      loading="{{loading}}"
      disabled="{{loading || !quickTitle}}"
      bindtap="onQuickAdd"
    >
      添加
    </button>
  </view>
</view>
