<view class="page todo-page" style="padding-top: {{navPaddingTop}}px;">
  <view class="masthead">
    <view class="masthead-copy">
      <text class="brand">今日待办</text>
      <view class="page-subtitle">{{daySubtitle}}</view>
      <view class="day-line">
        <text class="day-title">{{dayTitle}}</text>
        <text class="day-count">{{loadingDay ? '同步中' : tasks.length + ' 项安排'}}</text>
      </view>
    </view>
    <button class="add-button" bindtap="onOpenEditor" aria-label="创建详细待办">写</button>
  </view>

  <view
    class="offline-tip"
    hidden="{{pendingCount === 0}}"
    aria-live="polite"
    aria-atomic="true"
  >
    {{pendingCount}} 项操作将在恢复网络后同步
  </view>

  <view class="task-list">
    <view
      wx:for="{{tasks}}"
      wx:key="id"
      wx:for-item="task"
      class="task-row {{task.done ? 'task-row--done' : ''}}"
      data-id="{{task.id}}"
      bindlongpress="onTaskMenu"
      hover-class="task-row--pressed"
    >
      <view
        class="task-toggle"
        data-id="{{task.id}}"
        bindtap="onToggle"
        role="checkbox"
        aria-checked="{{task.done}}"
        aria-label="{{task.title}}，优先级：{{task.priorityLabel}}，截止：{{task.dueLabel}}，{{task.done ? '已完成' : '未完成'}}"
      >
        <view class="check" aria-hidden="true">{{task.done ? '✓' : ''}}</view>
        <view class="task-content" data-id="{{task.id}}" catchtap="onOpenTask">
          <text class="task-title">{{task.title}}</text>
          <view class="task-meta">
            <text class="priority priority--{{task.priority}}">{{task.priorityLabel}}</text>
            <text>{{task.dueLabel}}</text>
          </view>
        </view>
      </view>
      <button
        class="task-more"
        data-id="{{task.id}}"
        catchtap="onTaskMenu"
        aria-label="{{task.title}} 的更多操作"
      >
        ⋯
      </button>
    </view>

    <view wx:if="{{tasks.length === 0 && !loadingDay}}" class="empty">
      {{emptyLabel}}
    </view>
  </view>

  <view wx:if="{{tasks.length > 0}}" class="load-more">
    <text wx:if="{{loadingMore}}">加载中…</text>
    <text wx:elif="{{hasMore && isSelectedToday}}">上拉加载更多</text>
    <text wx:else>这一天就这些安排</text>
  </view>

  <view class="dock">
    <view class="quick-create">
      <input
        value="{{quickTitle}}"
        placeholder="记到这一天…"
        maxlength="100"
        confirm-type="done"
        bindinput="onQuickInput"
        bindconfirm="onQuickAdd"
        aria-label="待办标题"
      />
      <button
        class="quick-button"
        loading="{{loading}}"
        disabled="{{loading || !quickTitle}}"
        bindtap="onQuickAdd"
      >
        添加
      </button>
    </view>

    <view class="calendar-rail">
      <view class="rail-head">
        <text class="rail-title">按日查看</text>
        <button class="rail-toggle" bindtap="onToggleCalendar" aria-label="展开或收起月历">
          {{calendarOpen ? '收起月历' : '展开整月'}}
        </button>
      </view>
      <scroll-view class="week-strip" scroll-x enable-flex>
        <view
          wx:for="{{weekDays}}"
          wx:key="key"
          class="week-day {{item.key === selectedDate ? 'week-day--active' : ''}} {{item.isToday ? 'week-day--today' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelectDay"
        >
          <text class="week-weekday">{{item.weekday}}</text>
          <text class="week-number">{{item.label}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{calendarOpen}}" class="calendar-mask" bindtap="onCloseCalendar">
    <view class="calendar-sheet" catchtap="noop">
      <view class="sheet-handle" aria-hidden="true"></view>
      <view class="sheet-head">
        <button class="month-nav" size="mini" data-delta="-1" bindtap="onShiftMonth" aria-label="上个月">‹</button>
        <text class="sheet-title">{{monthTitle}}</text>
        <button class="month-nav" size="mini" data-delta="1" bindtap="onShiftMonth" aria-label="下个月">›</button>
      </view>
      <view class="weekday-row">
        <text wx:for="{{weekdayLabels}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="month-grid">
        <view
          wx:for="{{monthDays}}"
          wx:key="key"
          class="month-day {{item.inMonth ? '' : 'month-day--muted'}} {{item.key === selectedDate ? 'month-day--active' : ''}} {{item.isToday ? 'month-day--today' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSelectDay"
        >
          {{item.label}}
        </view>
      </view>
      <button class="ghost-button today-jump" bindtap="onJumpToday">回到今天</button>
    </view>
  </view>
</view>
