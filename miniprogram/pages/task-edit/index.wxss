.edit-page {
  padding-top: 36rpx;
}

.form-card {
  margin-top: 34rpx;
  padding: 0 28rpx;
}

.field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.field:last-child {
  border-bottom: 0;
}

.field--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  display: block;
  margin-bottom: 16rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  font-weight: 600;
}

.field--row .label {
  margin-bottom: 0;
}

.field input,
.field textarea {
  width: 100%;
  color: var(--ink);
  font-size: 30rpx;
}

.field textarea {
  min-height: 92rpx;
}

.picker-value {
  color: var(--accent-deep);
  font-size: 28rpx;
}

.inline-fields {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.date-chip {
  padding: 14rpx 22rpx;
  border-radius: 8rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 26rpx;
}

.save-button {
  margin-top: 40rpx;
}

.picker-value--muted {
  color: rgba(16, 36, 58, 0.35);
}

.repeat-hint {
  padding: 14rpx 0 2rpx;
  color: rgba(16, 36, 58, 0.45);
  font-size: 24rpx;
}

.scope-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(16, 36, 58, 0.45);
}

.scope-dialog {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 18rpx 18rpx 0 0;
  background: var(--card);
}

.scope-title {
  color: var(--ink);
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.scope-body {
  margin-top: 16rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.scope-action {
  margin-top: 28rpx;
  border-radius: 8rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 30rpx;
}

.scope-action--disabled {
  background: var(--paper-deep);
  color: rgba(16, 36, 58, 0.35);
}

.scope-cancel {
  margin-top: 24rpx;
  color: var(--ink-soft);
  font-size: 28rpx;
  text-align: center;
}
