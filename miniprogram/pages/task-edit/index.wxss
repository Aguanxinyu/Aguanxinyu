.edit-page {
  padding-top: 42rpx;
}

.form-card {
  margin-top: 38rpx;
  padding: 0 28rpx;
}

.field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.field:last-child {
  border-bottom: 0;
}

.field--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  display: block;
  margin-bottom: 16rpx;
  color: #475569;
  font-size: 26rpx;
  font-weight: 600;
}

.field--row .label {
  margin-bottom: 0;
}

.field input,
.field textarea {
  width: 100%;
  color: #0f172a;
  font-size: 30rpx;
}

.field textarea {
  min-height: 92rpx;
}

.picker-value {
  color: #2563eb;
  font-size: 28rpx;
}

.inline-fields {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.date-chip {
  padding: 14rpx 22rpx;
  border-radius: 16rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 26rpx;
}

.save-button {
  margin-top: 40rpx;
}

.picker-value--muted {
  color: #94a3b8;
}

.repeat-hint {
  padding: 14rpx 0 2rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.scope-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.45);
}

.scope-dialog {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
}

.scope-title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.scope-body {
  margin-top: 16rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.scope-action {
  margin-top: 28rpx;
  border-radius: 20rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 30rpx;
}

.scope-action--disabled {
  background: #e2e8f0;
  color: #94a3b8;
}

.scope-cancel {
  margin-top: 24rpx;
  color: #64748b;
  font-size: 28rpx;
  text-align: center;
}
