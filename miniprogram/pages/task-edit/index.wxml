<view class="page edit-page">
  <view class="page-title">{{pageTitle}}</view>
  <view class="page-subtitle">{{pageSubtitle}}</view>

  <view class="card form-card">
    <view class="field">
      <text class="label">标题</text>
      <input
        value="{{title}}"
        placeholder="准备做什么？"
        maxlength="100"
        focus
        aria-label="待办标题"
        bindinput="onTitleInput"
      />
    </view>
    <view class="field">
      <text class="label">备注</text>
      <textarea
        value="{{notes}}"
        placeholder="补充细节（选填）"
        maxlength="1000"
        auto-height
        aria-label="备注（选填）"
        bindinput="onNotesInput"
      />
    </view>
    <view class="field field--row">
      <text class="label">优先级</text>
      <picker
        value="{{priorityIndex}}"
        range="{{priorities}}"
        bindchange="onPriorityChange"
        aria-label="优先级"
      >
        <view class="picker-value">{{priorities[priorityIndex]}} ›</view>
      </picker>
    </view>
    <view class="field field--row">
      <text class="label">设置日期</text>
      <switch
        color="#2563EB"
        checked="{{hasDueDate}}"
        bindchange="onDueDateSwitch"
        aria-label="设置截止日期"
      />
    </view>
    <view wx:if="{{hasDueDate}}" class="inline-fields">
      <picker mode="date" value="{{date}}" bindchange="onDateChange" aria-label="选择日期">
        <view class="date-chip">{{date}}</view>
      </picker>
      <picker mode="time" value="{{time}}" bindchange="onTimeChange" aria-label="选择时间">
        <view class="date-chip">{{hasDueTime ? time : '选择时间'}}</view>
      </picker>
    </view>
    <view class="field field--row">
      <text class="label">微信提醒</text>
      <switch
        color="#2563EB"
        checked="{{reminderEnabled}}"
        bindchange="onReminderSwitch"
        aria-label="开启微信提醒"
      />
    </view>
    <view class="field field--row">
      <text class="label">重复</text>
      <picker
        value="{{repeatIndex}}"
        range="{{repeats}}"
        disabled="{{repeatDisabled}}"
        bindchange="onRepeatChange"
        aria-label="重复频率"
      >
        <view class="picker-value {{repeatDisabled ? 'picker-value--muted' : ''}}">
          {{repeats[repeatIndex]}} ›
        </view>
      </picker>
    </view>
    <view wx:if="{{repeatDisabled}}" class="repeat-hint">重复任务：修改仅影响本次</view>
    <view class="field">
      <text class="label">地点</text>
      <input
        value="{{locationName}}"
        placeholder="手动输入地点（选填）"
        maxlength="100"
        aria-label="地点（选填）"
        bindinput="onLocationInput"
      />
    </view>
  </view>

  <button class="primary-button save-button" loading="{{saving}}" bindtap="onSave">
    {{id.length > 0 ? '保存修改' : '保存待办'}}
  </button>

  <view wx:if="{{showScopeDialog}}" class="scope-mask">
    <view class="scope-dialog" aria-label="修改范围">
      <view class="scope-title">修改范围</view>
      <view class="scope-body">这是重复任务，修改仅影响本次待办。</view>
      <button class="scope-action" bindtap="onScopeOnlyThis">仅本次</button>
      <button class="scope-action scope-action--disabled" disabled>本次及以后（后续支持）</button>
      <view class="scope-cancel" bindtap="onScopeCancel">取消</view>
    </view>
  </view>
</view>
