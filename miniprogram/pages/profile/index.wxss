.profile-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 36rpx;
  padding: 30rpx;
}

.profile-mark {
  width: 86rpx;
  height: 86rpx;
  border-radius: 8rpx;
  background: var(--ink);
  color: #f7f2e8;
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 86rpx;
  text-align: center;
}

.profile-name {
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 32rpx;
  font-weight: 700;
}

.profile-caption {
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
}

.menu-card {
  overflow: hidden;
}

.menu-row {
  display: flex;
  min-height: 98rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--line);
  font-size: 29rpx;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-hint {
  color: var(--ink-soft);
  font-size: 26rpx;
}

.danger {
  color: var(--danger);
}

.privacy-note {
  padding: 48rpx 20rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.7;
  text-align: center;
}
