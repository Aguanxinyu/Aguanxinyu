.create-list {
  display: flex;
  align-items: center;
  margin-top: 40rpx;
  padding: 18rpx 18rpx 18rpx 26rpx;
}

.create-list input {
  flex: 1;
  height: 68rpx;
  font-size: 28rpx;
}

.create-list button {
  width: 120rpx;
  margin: 0 0 0 16rpx;
}

.list-card {
  overflow: hidden;
}

.list-row {
  display: flex;
  min-height: 106rpx;
  align-items: center;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.list-row:last-child {
  border-bottom: 0;
}

.list-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-align: center;
}

.list-name {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
}

.list-menu {
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 18rpx;
  background: transparent;
  color: #475569;
  font-size: 34rpx;
  line-height: 66rpx;
}

.list-menu::after {
  border: 0;
}
