.intro {
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.6;
}

.create-list {
  display: flex;
  align-items: center;
  padding: 18rpx 18rpx 18rpx 26rpx;
}

.create-list input {
  flex: 1;
  height: 68rpx;
  font-size: 28rpx;
}

.create-list button {
  width: 120rpx;
  margin: 0 0 0 16rpx;
}

.list-card {
  overflow: hidden;
}

.list-row {
  display: flex;
  min-height: 118rpx;
  align-items: center;
  padding: 18rpx 20rpx 18rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.list-row:last-child {
  border-bottom: 0;
}

.list-row--inbox {
  background: rgba(15, 118, 110, 0.06);
}

.list-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 8rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 58rpx;
  text-align: center;
}

.list-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.list-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.list-meta {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 22rpx;
}

.list-chevron {
  margin-right: 4rpx;
  color: rgba(16, 36, 58, 0.35);
  font-size: 34rpx;
}

.list-menu {
  width: 72rpx;
  height: 72rpx;
  margin: 0 0 0 4rpx;
  padding: 0;
  border: 0;
  border-radius: 8rpx;
  background: transparent;
  color: var(--ink-soft);
  font-size: 34rpx;
  line-height: 66rpx;
}

.list-menu::after {
  border: 0;
}
