<view class="page">
  <view class="brand">今日待办</view>
  <view class="page-subtitle">清单 · 按生活场景整理</view>

  <view class="card create-list">
    <input
      value="{{newName}}"
      placeholder="新清单名称"
      maxlength="20"
      aria-label="新清单名称"
      bindinput="onNameInput"
      bindconfirm="onCreate"
    />
    <button class="ghost-button" bindtap="onCreate">创建</button>
  </view>

  <view class="section-title">我的清单 · {{lists.length}}</view>
  <view class="card list-card">
    <view
      wx:for="{{lists}}"
      wx:key="id"
      wx:for-item="item"
      class="list-row"
      data-id="{{item.id}}"
      bindlongpress="onListMenu"
    >
      <view class="list-icon">{{item.isInbox ? '收' : '清'}}</view>
      <text class="list-name">{{item.name}}</text>
      <button
        wx:if="{{!item.isInbox}}"
        class="list-menu"
        data-id="{{item.id}}"
        catchtap="onListMenu"
        aria-label="管理清单 {{item.name}}"
      >
        ⋯
      </button>
    </view>
    <view wx:if="{{!loading && lists.length === 0}}" class="empty">
      暂无清单
    </view>
  </view>
</view>
