page {
  --ink: #10243a;
  --ink-soft: #3d556e;
  --paper: #f3efe6;
  --paper-deep: #e7e0d2;
  --card: #fffdf8;
  --line: rgba(16, 36, 58, 0.08);
  --accent: #0f766e;
  --accent-soft: #d9f3ef;
  --accent-deep: #0b5b55;
  --warn: #b45309;
  --warn-soft: #fff1de;
  --danger: #b42318;
  --high: #9f1239;
  --high-soft: #ffe4e6;
  --mid: #a16207;
  --mid-soft: #fef3c7;
  --low: #166534;
  --low-soft: #dcfce7;
  min-height: 100%;
  background:
    radial-gradient(circle at top left, rgba(15, 118, 110, 0.08), transparent 32%),
    linear-gradient(180deg, #f7f3ea 0%, var(--paper) 48%, #ebe4d6 100%);
  color: var(--ink);
  font-family: 'PingFang SC', 'Hiragino Sans GB', 'Noto Sans SC', sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-top: calc(env(safe-area-inset-top) + 88rpx);
  padding-right: 28rpx;
  padding-bottom: 220rpx;
  padding-left: 28rpx;
}

.brand {
  margin: 0;
  color: var(--ink);
  font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.15;
}

.page-title {
  margin: 0;
  font-family: 'Songti SC', 'STSong', 'Noto Serif SC', serif;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.page-subtitle {
  margin-top: 10rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.5;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: var(--card);
  box-shadow: 0 18rpx 40rpx rgba(16, 36, 58, 0.05);
}

.primary-button {
  border: 0;
  border-radius: 8rpx;
  background: var(--accent);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-button::after,
.ghost-button::after {
  border: 0;
}

.ghost-button {
  border: 0;
  border-radius: 8rpx;
  background: var(--accent-soft);
  color: var(--accent-deep);
  font-size: 28rpx;
}

.empty {
  padding: 88rpx 32rpx;
  color: var(--ink-soft);
  text-align: center;
  line-height: 1.7;
}

.section-title {
  margin: 36rpx 8rpx 18rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}
