page {
  min-height: 100%;
  background: #f6f7fb;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 28rpx 180rpx;
}

.page-title {
  margin: 0;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 26rpx;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid rgba(148, 163, 184, 0.14);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.05);
}

.primary-button {
  border: 0;
  border-radius: 24rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.primary-button::after,
.ghost-button::after {
  border: 0;
}

.ghost-button {
  border: 0;
  border-radius: 20rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 28rpx;
}

.empty {
  padding: 88rpx 32rpx;
  color: #94a3b8;
  text-align: center;
}

.section-title {
  margin: 42rpx 8rpx 18rpx;
  color: #475569;
  font-size: 26rpx;
  font-weight: 600;
}
