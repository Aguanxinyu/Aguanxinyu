{
  "name": "today-todo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "functions/*",
    "web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build --pretty false && tsc --project tsconfig.test.json --pretty false && tsc --project miniprogram/tsconfig.json --pretty false && npm run typecheck -w @today-todo/web",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node --env-file-if-exists=.env packages/backend/scripts/migrate.js",
    "start": "npm run build -w @today-todo/backend && node --env-file-if-exists=.env packages/backend/dist/server.js",
    "web:dev": "npm run dev -w @today-todo/web",
    "web:build": "npm run build -w @today-todo/web",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "miniprogram-api-typings": "^5.2.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "protobufjs": "8.7.1",
    "nanoid": "3.3.18"
  }
}
