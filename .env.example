# 生产数据库连接串（迁移与后端运行时使用）
DATABASE_URL=postgres://todo:CHANGE_ME@127.0.0.1:5432/todaytodo
# 集成测试数据库（独立库，避免污染生产数据）
PG_TEST_DATABASE_URL=postgres://todo:CHANGE_ME@127.0.0.1:5432/todaytodo_test
# HTTP 服务端口（默认 8080，nginx 反代到该端口）
PORT=8080
# 微信小程序 AppID / AppSecret（登录 code2session 与订阅消息 access_token）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 订阅消息模板 ID 与关键字字段映射（thing 类标题截断 20 字，time 类格式 YYYY-MM-DD HH:mm）
WECHAT_REMINDER_TEMPLATE_ID=
WECHAT_REMINDER_TEMPLATE_FIELDS={"thing1":"title","time2":"dueAt"}
WECHAT_REMINDER_PAGE=pages/todos/index
# 仅本地联调：把任意 code 映射为 openid:${code}，绕过微信登录（生产关闭）
# DEV_FAKE_LOGIN=1
